FROM docker.io/library/python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN groupadd --gid 10001 wgdb \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin wgdb

COPY pyproject.toml alembic.ini ./
COPY alembic ./alembic
COPY app ./app
COPY scripts ./scripts

RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir .

RUN printf '%s\n' \
    '#!/usr/bin/env python3' \
    'import urllib.request' \
    'with urllib.request.urlopen("http://127.0.0.1:8000/health", timeout=3) as response:' \
    '    raise SystemExit(0 if response.status == 200 else 1)' \
    > /usr/local/bin/wgdb-healthcheck \
    && chmod 0755 /usr/local/bin/wgdb-healthcheck \
    && chown -R wgdb:wgdb /app

USER wgdb

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/usr/local/bin/wgdb-healthcheck"]

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
