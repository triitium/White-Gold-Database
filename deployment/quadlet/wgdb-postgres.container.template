[Unit]
Description=WGDB PostgreSQL 18
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/library/postgres:18.6-alpine
ContainerName=wgdb-postgres
Network=wgdb-network.network
NetworkAlias=postgres
EnvironmentFile=@@WGDB_CONFIG@@/postgres.env
Volume=wgdb-postgres.volume:/var/lib/postgresql
HealthCmd=pg_isready -U wgdb_app -d wgdb
HealthInterval=10s
HealthTimeout=5s
HealthRetries=6
HealthStartPeriod=10s
Notify=healthy

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=120
TimeoutStopSec=90

[Install]
WantedBy=default.target
