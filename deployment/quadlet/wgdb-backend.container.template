[Unit]
Description=WGDB FastAPI backend
Requires=wgdb-postgres.service
After=wgdb-postgres.service

[Container]
Image=wgdb-backend.build
ContainerName=wgdb-backend
Network=wgdb-network.network
NetworkAlias=backend
EnvironmentFile=@@WGDB_CONFIG@@/backend.env
PublishPort=127.0.0.1:18000:8000
HealthCmd=/usr/local/bin/wgdb-healthcheck
HealthInterval=20s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=10s
Notify=healthy
NoNewPrivileges=true

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=120
TimeoutStopSec=45

[Install]
WantedBy=default.target
