# chmod 600. Generate SECRET_KEY with: openssl rand -hex 32
# Keep the DB password URL-safe (e.g. openssl rand -hex 32) so DATABASE_URL needs no escaping.
DATABASE_URL=postgresql+psycopg://wgdb_app:CHANGE_ME_DB_PASSWORD@postgres:5432/wgdb
SECRET_KEY=CHANGE_ME_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
TMDB_READ_ACCESS_TOKEN=CHANGE_ME_TMDB_TOKEN
TMDB_LANGUAGE=de-DE
# Same-origin deployment does not require browser CORS. Keeping the list empty is deliberate.
CORS_ORIGINS=[]
